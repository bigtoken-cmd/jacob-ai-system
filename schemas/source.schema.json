{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Provenance-Aware Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "location", "observedAt", "reliability", "freshness"],
  "properties": {
    "id": { "type": "string", "pattern": "^SRC-[0-9]+$" },
    "kind": { "enum": ["chat", "file", "webpage", "assignment", "conversation", "memory", "decision", "other"] },
    "location": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "observedAt": { "type": "string", "format": "date-time" },
    "reliability": { "enum": ["primary", "secondary", "inferred", "unknown"] },
    "freshness": { "enum": ["current", "dated", "stale", "unknown"] },
    "authority": { "type": "string" },
    "contentHash": { "type": "string" },
    "supports": { "type": "array", "items": { "type": "string" } },
    "contradicts": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reviewState": { "enum": ["unreviewed", "reviewed", "approved", "rejected", "needs-update"] },
    "notes": { "type": "string" }
  }
}
