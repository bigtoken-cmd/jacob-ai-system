{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Universal AI Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "request", "goal", "status", "acceptanceCriteria", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
    "request": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "taskType": { "type": ["string", "null"] },
    "status": { "enum": ["queued", "planning", "running", "awaiting-review", "blocked", "failed", "completed", "cancelled"] },
    "contextRefs": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "deliverable": { "$ref": "#/$defs/deliverable" },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "approval": { "$ref": "#/$defs/approval" },
    "custom": { "type": "object", "additionalProperties": true },
    "parentTaskId": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["label"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": true }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": true,
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "format": { "type": "string" },
        "destination": { "type": "string" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "actions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
