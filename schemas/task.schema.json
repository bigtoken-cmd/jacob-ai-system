{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "AI System Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "domain", "title", "goal", "status", "acceptanceCriteria", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
    "domain": { "enum": ["parasyte", "school", "lincoln-prospects", "system"] },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "status": { "enum": ["queued", "running", "awaiting-review", "blocked", "failed", "completed", "cancelled"] },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "sourceIds": { "type": "array", "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "approvalRequired": { "type": "boolean" },
    "parentTaskId": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
